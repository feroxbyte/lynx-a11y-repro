{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "composite": true,

    "jsx": "react-jsx",
    "jsxImportSource": "@lynx-js/react",
    "types": ["@lynx-js/rspeedy/client"],

    // Lynx runs modern JavaScript; without this TypeScript 5 assumes ES5 (no Array.find).
    "target": "ES2020",
    "lib": ["ES2020"],

    "module": "ESNext",
    "moduleResolution": "Bundler",

    "noEmit": true
  },
  "include": ["./**/*.ts", "./**/*.tsx"]
}
